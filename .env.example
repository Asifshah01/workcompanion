# =============================================================================
# WorkCompanion AI - configuration
# =============================================================================
# Copy this file to `.env` and edit it.  Every value here has a working default,
# so the app runs with no configuration at all.
#
#   copy .env.example .env
#
# `.env.local` is also read (and takes precedence).  It is what the in-app
# Settings page writes, so your `.env` is never modified by the UI.
#
# The only value you normally must set is GROQ_API_KEY.  Without it the app
# falls back to a deterministic offline provider and labels every answer
# accordingly - nothing crashes.
# =============================================================================


# -----------------------------------------------------------------------------
# LLM - Groq is the primary provider
# -----------------------------------------------------------------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# 'groq' uses the API. 'offline' forces the built-in deterministic provider,
# which is useful for demos, tests and air-gapped machines.
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.3
# The free tier allows about 1000 output tokens per minute per model, so a large
# ceiling will exhaust the budget mid-session and start returning 429s. 2200 is
# fine on a paid tier; drop to ~1000 on the free one.
GROQ_MAX_TOKENS=2200
GROQ_TIMEOUT_SECONDS=90
# Rate limits are retried using the provider's own "try again in Ns" hint, so a
# few attempts are worth having.
GROQ_MAX_RETRIES=3


# -----------------------------------------------------------------------------
# Embeddings - local by default, no API calls
# -----------------------------------------------------------------------------
# 'auto' uses sentence-transformers when installed, else a dependency-free
# hashing embedder. Force either one with the explicit values.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64


# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Where documents, the vector store and caches live.
DATA_DIR=./data
DOCUMENTS_DIR=./data/documents
VECTOR_DB_PATH=./data/vectorstore
CACHE_DIR=./data/cache

# 'chroma' persists to disk; 'memory' is throwaway and ideal for tests.
VECTOR_STORE_PROVIDER=chroma
VECTOR_STORE_COLLECTION=workcompanion

# SQLite out of the box; point at Postgres with, e.g.:
#   postgresql+psycopg://workcompanion:secret@localhost:5432/workcompanion
DATABASE_URL=
# Log every SQL statement (noisy; useful when debugging the schema).
ECHO_SQL=false


# -----------------------------------------------------------------------------
# RAG - chunking, hybrid retrieval, reranking, compression
# -----------------------------------------------------------------------------
CHUNK_TARGET_CHARS=1100
CHUNK_OVERLAP_CHARS=180
CHUNK_MIN_CHARS=180

# Hybrid dense + sparse (BM25) retrieval. Weights are normalised at load time.
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3

# How many chunks each stage keeps.
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=24

# One extra paraphrased query per request beyond the original.
MULTI_QUERY_COUNT=2

# Rewrite conversational questions into standalone search queries, and expand
# them with keywords/synonyms.
ENABLE_QUERY_REWRITE=true
ENABLE_QUERY_EXPANSION=true

# 'auto' (cross-encoder if available), 'local' (dependency-free), 'cross-encoder',
# or 'llm'. 'auto' falls back silently when the model is not installed.
RERANKER=auto
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=12

# Drop redundant sentences before the context reaches the model.
CONTEXT_COMPRESSION=true
COMPRESSOR_MAX_SENTENCES=6

# Verify that a citation's quote actually appears in its chunk.
CITATION_GROUNDING_CHECK=true

# Below this retrieval confidence the agents refuse rather than stretch loosely
# related passages. Raise it to make the system more conservative.
MIN_RETRIEVAL_CONFIDENCE=0.15


# -----------------------------------------------------------------------------
# Agents and orchestration
# -----------------------------------------------------------------------------
# CrewAI is optional. When false (or uninstalled), multi-step work is done by
# direct agent calls instead of crews - same results, no dependency.
ENABLE_CREWAI=true
CREWAI_VERBOSE=false
MAX_AGENT_STEPS=8

DEFAULT_EXPLANATION_LEVEL=undergraduate
DEFAULT_TEACHING_STYLE=detailed
# concise | detailed | socratic | example_based | mathematical | analogy


# -----------------------------------------------------------------------------
# Web research (keyless DuckDuckGo HTML endpoint; fails soft)
# -----------------------------------------------------------------------------
ENABLE_WEB_RESEARCH=true
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_TIMEOUT=15
WEB_MAX_RESULTS=5


# -----------------------------------------------------------------------------
# OCR fallback for scanned PDFs
# -----------------------------------------------------------------------------
ENABLE_OCR_FALLBACK=true
# 'auto' uses pytesseract when tesseract is on PATH; 'none' disables it.
OCR_ENGINE=auto
# A page with fewer extractable characters than this is treated as a scan.
OCR_MIN_CHARS_PER_PAGE=180
OCR_MAX_PAGES=25


# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------
MAX_UPLOAD_MB=40
ENABLE_FILE_VALIDATION=true
# Comma-separated. Add a loader before allowing its extension.
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt,.md,.markdown,.pptx,.csv,.html,.htm


# -----------------------------------------------------------------------------
# Caching
# -----------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
EMBEDDING_CACHE_ENABLED=true


# -----------------------------------------------------------------------------
# App behaviour
# -----------------------------------------------------------------------------
APP_NAME=WorkCompanion AI
APP_TAGLINE=Multi-agent AI study & research companion
DEBUG=false
LOG_LEVEL=INFO

# Index the bundled demo corpus automatically when the knowledge base is empty.
DEMO_MODE_AUTOLOAD=true

TELEMETRY_ENABLED=true